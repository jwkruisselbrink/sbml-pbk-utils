            <ci> scVRest </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="QBlood">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> QCC </ci>
            <apply>
              <power/>
              <ci> BW </ci>
              <cn> 0.75 </cn>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="QLiver">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> QBlood </ci>
            <ci> QLc </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="QRest">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> QBlood </ci>
            <ci> QRc </ci>
          </apply>
        </math>
      </assignmentRule>
    </listOfRules>
